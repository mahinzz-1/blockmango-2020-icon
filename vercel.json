{
  "version": 2,
  "builds": [
    { "src": "index.js", "use": "@vercel/node", "config": { "includeFiles": "skins.json" } },
    { "src": "icons/**", "use": "@vercel/static" },
    { "src": "skins.json", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/icons/(\\d+)\\.png", "dest": "/icons/$1.png" },
    { "src": "/skins.json", "dest": "/skins.json" },
    { "src": "/(.*)", "dest": "/index.js" }
  ]
}
